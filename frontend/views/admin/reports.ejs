<% layout('layouts/admin') %><div class="page-actions"><div class="tabs"><a class="<%= !filter ? 'active' : '' %>" href="/admin/reports">All</a><% ['open','reviewing','resolved','dismissed'].forEach(item => { %><a class="<%= filter === item ? 'active' : '' %>" href="/admin/reports?status=<%= item %>"><%= item %></a><% }) %></div></div><div class="report-list"><% reports.forEach(report => { %><article class="panel report-card"><div class="report-card__head"><div><span class="status status--<%= report.status %>"><%= report.status %></span><h2><%= report.profile?.name || 'General report' %></h2><p><%= report.reason %> · <%= new Date(report.createdAt).toLocaleString() %></p></div><% if (report.profile) { %><a href="/admin/profiles/edit/<%= report.profile._id %>">Open profile →</a><% } %></div><p class="report-details"><%= report.details || 'No additional detail supplied.' %></p><% if (report.reporterEmail) { %><small>Reporter: <%= report.reporterEmail %></small><% } %><form class="report-resolution" method="post" action="/admin/reports/<%= report._id %>?_method=PUT"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><% ['open','reviewing','resolved','dismissed'].forEach(item => { %><option <%= report.status === item ? 'selected' : '' %>><%= item %></option><% }) %></select><input name="resolutionNotes" value="<%= report.resolutionNotes %>" maxlength="2000" placeholder="Internal resolution note"><button class="admin-button admin-button--small">Update</button></form></article><% }) %><% if (!reports.length) { %><div class="panel admin-empty">No reports in this view.</div><% } %></div>
