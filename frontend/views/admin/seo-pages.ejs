<% layout('layouts/admin') %><div class="content-split"><section class="panel form-section"><p class="kicker">Optional override</p><h2>City + category SEO</h2><p class="muted">Pages with listings already receive sensible unique metadata. Add an override only when you have useful, specific content.</p><form class="stack-form" method="post" action="/admin/seo-pages"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>City<select name="city" required><option value="">Select</option><% cities.forEach(item => { %><option value="<%= item._id %>"><%= item.name %></option><% }) %></select></label><label>Category<select name="category" required><option value="">Select</option><% categories.forEach(item => { %><option value="<%= item._id %>"><%= item.name %></option><% }) %></select></label><label>Page H1<input name="h1" maxlength="180"></label><label>SEO title<input name="seoTitle" maxlength="70"></label><label>SEO description<textarea name="seoDescription" maxlength="170" rows="3"></textarea></label><label>Intro content<textarea name="introContent" maxlength="5000" rows="6"></textarea></label><label class="toggle"><input type="checkbox" name="indexable" checked><span>Allow indexing when listings exist</span></label><button class="admin-button">Save override</button></form></section><section class="panel"><div class="panel-heading"><div><p class="kicker">Existing content</p><h2>SEO overrides</h2></div><span><%= pages.length %></span></div><div class="mini-list"><% pages.forEach(page => { %><div><span class="status status--<%= page.indexable ? 'published' : 'hidden' %>"><%= page.indexable ? 'index' : 'noindex' %></span><b><%= page.city?.name %> + <%= page.category?.name %></b><small><%= page.seoTitle || 'Dynamic title' %></small></div><% }) %></div><% if (!pages.length) { %><div class="admin-empty">No overrides. Dynamic metadata is active.</div><% } %></section></div>
