<% layout('layouts/admin') %>
<div class="content-split">
  <section class="panel form-section">
    <p class="kicker">New location</p>
    <h2>Add city</h2>
    <form class="stack-form" method="post" action="/admin/cities">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Name
        <input name="name" required maxlength="100" placeholder="e.g. Mumbai">
      </label>
      <label>Slug
        <input name="slug" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="Generated from name">
      </label>
      <label>Phone / Call Number (City Specific)
        <input name="phone" inputmode="tel" maxlength="24" placeholder="e.g. 6351615378 (Leave empty for default)">
      </label>
      <label>WhatsApp Number (City Specific)
        <input name="whatsapp" inputmode="tel" maxlength="24" placeholder="e.g. 916351615378 (Leave empty for default)">
      </label>
      <label>Page H1
        <input name="h1" maxlength="180" placeholder="e.g. Call Girls in Mumbai — Verified Escorts">
      </label>
      <label>Description
        <textarea name="description" rows="5" maxlength="5000" placeholder="City description / intro text..."></textarea>
      </label>
      <label>SEO title
        <input name="seoTitle" maxlength="120">
      </label>
      <label>SEO description
        <textarea name="seoDescription" rows="3" maxlength="170"></textarea>
      </label>
      <label>Sort order
        <input type="number" name="sortOrder" value="0">
      </label>
      <label class="toggle">
        <input type="checkbox" name="active" checked>
        <span>Active</span>
      </label>
      <button class="admin-button" type="submit">Add city</button>
    </form>
  </section>

  <section class="panel">
    <div class="panel-heading">
      <div>
        <p class="kicker">Dynamic routes</p>
        <h2>All cities</h2>
      </div>
      <span><%= items.length %> total</span>
    </div>
    <div class="accordion-list">
      <% items.forEach(item => { %>
        <details>
          <summary>
            <div>
              <b><%= item.name %></b>
              <small>/<%= item.slug %></small>
              <% if (item.phone || item.whatsapp) { %>
                <small style="color: #c98838; margin-left: 8px;">📞 <%= item.phone || 'Default' %> · 💬 <%= item.whatsapp || 'Default' %></small>
              <% } %>
            </div>
            <span class="status status--<%= item.active ? 'published' : 'hidden' %>"><%= item.active ? 'active' : 'disabled' %></span>
          </summary>
          <form class="stack-form" method="post" action="/admin/cities/<%= item._id %>?_method=PUT">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-grid">
              <label>Name
                <input name="name" value="<%= item.name %>" required>
              </label>
              <label>Slug
                <input name="slug" value="<%= item.slug %>" required>
              </label>
              <label>City Call / Phone Number
                <input name="phone" value="<%= item.phone || '' %>" inputmode="tel" placeholder="e.g. 6351615378 (Empty for default)">
              </label>
              <label>City WhatsApp Number
                <input name="whatsapp" value="<%= item.whatsapp || '' %>" inputmode="tel" placeholder="e.g. 916351615378 (Empty for default)">
              </label>
              <label class="span-2">H1
                <input name="h1" value="<%= item.h1 || '' %>">
              </label>
              <label class="span-2">Description
                <textarea name="description" rows="4"><%= item.description || '' %></textarea>
              </label>
              <label class="span-2">SEO title
                <input name="seoTitle" maxlength="120" value="<%= item.seoTitle || '' %>">
              </label>
              <label class="span-2">SEO description
                <textarea name="seoDescription" maxlength="170"><%= item.seoDescription || '' %></textarea>
              </label>
              <label>Sort order
                <input type="number" name="sortOrder" value="<%= item.sortOrder || 0 %>">
              </label>
              <label class="toggle">
                <input type="checkbox" name="active" <%= item.active ? 'checked' : '' %>>
                <span>Active</span>
              </label>
            </div>
            <div class="form-actions">
              <button class="admin-button" type="submit">Save city</button>
              <button class="danger-button" type="submit" formaction="/admin/cities/<%= item._id %>?_method=DELETE" data-confirm="Delete this unused city?">Delete</button>
            </div>
          </form>
        </details>
      <% }) %>
    </div>
  </section>
</div>
