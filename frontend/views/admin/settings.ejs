<% layout('layouts/admin') %><section class="panel form-section narrow-panel"><p class="kicker">Directory defaults</p><h2>Site settings</h2><p class="muted">Environment variables continue to control secrets and infrastructure credentials.</p><form class="stack-form" method="post" action="/admin/settings?_method=PUT"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Site name<input name="siteName" value="<%= siteSettings.siteName || 'Sanjana Malhotra' %>" maxlength="180"></label><label>Public contact email<input type="email" name="contactEmail" value="<%= siteSettings.contactEmail || '' %>" maxlength="180"></label><label>Footer statement<textarea name="footerText" maxlength="300" rows="4"><%= siteSettings.footerText || '' %></textarea></label><button class="admin-button" type="submit">Save settings</button></form></section>
