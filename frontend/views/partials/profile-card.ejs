<article class="profile-card">
  <a class="profile-card__media" href="/profile/<%= profile.slug %>">
    <% if (profile.mainImage) { %><img src="<%= profile.mainImage.url %>" alt="<%= profile.mainImage.alt || profile.name %>" loading="lazy" width="640" height="800"><% } else { %><div class="image-placeholder" aria-label="Image pending"><span><%= profile.name.charAt(0) %></span></div><% } %>
    <% if (profile.badge !== 'NORMAL') { %><span class="badge badge--<%= profile.badge.toLowerCase() %>"><%= profile.badge %></span><% } %>
    <% if (profile.featured) { %><span class="featured-mark">Featured</span><% } %>
    <span class="adult-verified">18+ VERIFIED</span>
  </a>
  <div class="profile-card__body">
    <p class="profile-card__meta"><a href="/<%= profile.city.slug %>"><%= profile.city.name %></a><span>•</span><a href="/category/<%= profile.category.slug %>"><%= profile.category.name %></a></p>
    <h3><a href="/profile/<%= profile.slug %>"><%= profile.name %></a></h3>
    <p><%= profile.description.length > 100 ? profile.description.slice(0, 100) + '…' : profile.description %></p>
    <div class="profile-card__actions">
      <a class="button button--whatsapp button--small" href="<%= profile.whatsappUrl || `/profile/${profile.slug}#connect` %>" <% if (profile.whatsappUrl) { %>target="_blank" rel="noopener noreferrer"<% } %>>
        <svg class="whatsapp-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.978-.276-.1-.477-.15-.677.15-.2.301-.777.978-.953 1.18-.175.201-.351.226-.652.075-.301-.15-1.272-.469-2.423-1.496-.895-.799-1.5-1.786-1.676-2.087-.175-.301-.019-.464.132-.614.136-.135.301-.351.452-.527.15-.175.2-.301.301-.501.1-.201.05-.376-.025-.527-.075-.15-.677-1.633-.928-2.238-.244-.59-.492-.51-.677-.52l-.577-.01c-.2 0-.527.075-.803.376s-1.053 1.028-1.053 2.508 1.079 2.909 1.229 3.11c.15.201 2.124 3.243 5.145 4.549.719.31 1.28.496 1.718.636.722.23 1.378.197 1.898.12.579-.087 1.78-.728 2.03-1.43.25-.703.25-1.305.175-1.43-.075-.125-.276-.201-.577-.351z"/>
          <path d="M12 2C6.477 2 2 6.477 2 12c0 1.892.524 3.662 1.435 5.178L2 22l4.98-1.39A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.05c-1.626 0-3.14-.478-4.417-1.302l-.317-.204-2.964.827.842-2.887-.225-.339A8.006 8.006 0 0 1 4 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8.05-8 8.05z"/>
        </svg>
        <span>WhatsApp</span>
      </a>
      <a class="text-link" href="/profile/<%= profile.slug %>">View profile →</a>
    </div>
  </div>
</article>
