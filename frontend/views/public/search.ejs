<% layout('layouts/public') %>
<section class="page-hero page-hero--compact"><div class="container"><span class="eyebrow">Tailored discovery</span><h1>Find the right profile</h1><p>Search by name, city, category, or profile tier.</p></div></section>
<section class="section section--cream"><div class="container search-layout"><aside><form class="filter-panel" method="get" action="/search"><h2>Refine results</h2><label>Profile name<input type="search" name="q" value="<%= q %>" placeholder="Search by name"></label><label>City<select name="city"><option value="">All cities</option><% cities.forEach(item => { %><option value="<%= item._id %>" <%= String(filters.city) === String(item._id) ? 'selected' : '' %>><%= item.name %></option><% }) %></select></label><label>Category<select name="category"><option value="">All categories</option><% categories.forEach(item => { %><option value="<%= item._id %>" <%= String(filters.category) === String(item._id) ? 'selected' : '' %>><%= item.name %></option><% }) %></select></label><label>Tier<select name="badge"><option value="">All tiers</option><% ['VVIP','VIP','HOT','NORMAL'].forEach(item => { %><option value="<%= item %>" <%= filters.badge === item ? 'selected' : '' %>><%= item %></option><% }) %></select></label><label class="check-row"><input type="checkbox" name="featured" value="true" <%= filters.featured === 'true' ? 'checked' : '' %>><span>Featured only</span></label><button class="button button--gold" type="submit">Apply filters</button><a class="text-link" href="/search">Clear all</a></form></aside><div><div class="results-bar"><h2><%= q ? `Results for “${q}”` : 'All profiles' %></h2><span><%= total %> found</span></div><% if (profiles.length) { %><div class="card-grid card-grid--two"><% profiles.forEach(profile => { %><%- include('../partials/profile-card', { profile }) %><% }) %></div><%- include('../partials/pagination', { page, pages, filters }) %><% } else { %><div class="empty-state"><h2>No matching profiles</h2><p>Try removing a filter or using a different search phrase.</p><a class="button button--gold" href="/search">Reset search</a></div><% } %></div></div></section>
