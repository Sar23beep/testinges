<% layout('layouts/public') %>
<section class="page-hero"><div class="container"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><% if (city) { %><a href="/<%= city.slug %>"><%= city.name %></a><% } %><% if (category) { %><span>›</span><a href="/category/<%= category.slug %>"><%= category.name %></a><% } %></nav><span class="eyebrow">Curated directory</span><h1><%= heading %></h1><p><%= intro || `Explore ${total} published profiles.` %></p></div></section>
<section class="section section--cream"><div class="container"><div class="results-bar"><span><strong><%= total %></strong> profile<%= total === 1 ? '' : 's' %></span><a class="button button--ghost-dark button--small" href="/search">Refine search</a></div><% if (profiles.length) { %><div class="card-grid"><% profiles.forEach(profile => { %><%- include('../partials/profile-card', { profile }) %><% }) %></div><%- include('../partials/pagination', { page, pages, filters: {} }) %><% } else { %><div class="empty-state"><span>✦</span><h2>No published profiles yet</h2><p>This page is not indexed until it has meaningful listings. Try a broader search.</p><a class="button button--gold" href="/search">Browse all profiles</a></div><% } %></div></section>
<% if (relatedCategories.length || relatedCities.length) { %><section class="section section--light"><div class="container"><div class="section-heading"><div><span class="eyebrow eyebrow--dark">Keep exploring</span><h2>Related destinations</h2></div></div><div class="pill-grid"><% relatedCategories.forEach(item => { %><a class="city-pill" href="<%= city ? `/${city.slug}/${item.slug}` : `/category/${item.slug}` %>"><strong><%= item.name %></strong><span>Explore →</span></a><% }) %><% relatedCities.forEach(item => { %><a class="city-pill" href="<%= category ? `/${item.slug}/${category.slug}` : `/${item.slug}` %>"><strong><%= item.name %></strong><span>Explore →</span></a><% }) %></div></div></section><% } %>
