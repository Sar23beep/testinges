<% layout('layouts/public') %>

<section class="page-hero">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <% if (city) { %><a href="/<%= city.slug %>"><%= city.name %></a><% } %>
      <% if (category) { %><span>›</span><a href="/category/<%= category.slug %>"><%= category.name %></a><% } %>
    </nav>
    <span class="eyebrow">100% 18+ Verified Directory</span>
    <h1><%= heading %></h1>
    <p><%= intro || `Explore 18+ verified call girls and independent escorts in ${city ? city.name : 'India'}. Direct WhatsApp contact on ${typeof displayWhatsapp !== 'undefined' ? displayWhatsapp : '6351615378'}.` %></p>
  </div>
</section>

<section class="section section--cream">
  <div class="container">
    <div class="results-bar">
      <span><strong><%= total %></strong> Verified <%= city ? `Call Girls in ${city.name}` : (category ? `${category.name} Escorts` : 'Profiles') %></span>
      <a class="button button--ghost-dark button--small" href="/search">Refine search</a>
    </div>

    <% if (profiles.length) { %>
      <div class="card-grid">
        <% profiles.forEach(profile => { %>
          <%- include('../partials/profile-card', { profile }) %>
        <% }) %>
      </div>
      <%- include('../partials/pagination', { page, pages, filters: {} }) %>
    <% } else { %>
      <div class="empty-state">
        <span>✦</span>
        <h2>No published profiles yet in this area</h2>
        <p>Browse nearby cities or use search to find 100% verified call girls and escorts.</p>
        <a class="button button--gold" href="/search">Browse all profiles</a>
      </div>
    <% } %>
  </div>
</section>

<% if (city) { %>
<!-- Rich On-Page SEO Section for Search Engine Rankings -->
<section class="section section--light seo-guide-section" style="padding: 48px 0; background: #fff;">
  <div class="container prose" style="max-width: 900px; margin: 0 auto; color: #333; line-height: 1.8;">
    <span class="eyebrow eyebrow--dark" style="color: #b31b3b; font-weight: 700; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px;">City Guide & Standards</span>
    <h2 style="font-size: 1.85rem; font-family: 'Playfair Display', serif; margin-top: 8px; color: #111;">Top Rated Call Girls & Escort Service in <%= city.name %></h2>
    
    <p>Welcome to <strong>Sanjana Malhotra</strong>, India's most trusted 18+ discovery platform for <strong>Call Girls in <%= city.name %></strong> and independent verified escorts. Whether you are visiting <%= city.name %> for a business trip, holiday, or looking for upscale private companionship, our platform connects you directly with top-tier models, VIP companions, independent college girls, and high-profile elite escorts.</p>
    
    <h3 style="font-size: 1.35rem; margin-top: 24px; color: #111;">Why Choose Independent Call Girls in <%= city.name %>?</h3>
    <ul style="padding-left: 20px; margin-bottom: 20px;">
      <li><strong>100% Verified Genuine Photos:</strong> Every model photo is verified with zero fake or misleading stock images.</li>
      <li><strong>Direct WhatsApp & Call Contact:</strong> Connect directly with verified models without brokers, agency commissions, or third-party delays.</li>
      <li><strong>Complete Discretion & Privacy:</strong> Safe, confidential, and judgment-free meetings tailored to your convenience across top hotels and residences in <%= city.name %>.</li>
      <li><strong>Zero Advance Frauds:</strong> Transparent independent interactions with genuine companions.</li>
    </ul>

    <h3 style="font-size: 1.35rem; margin-top: 24px; color: #111;">Frequently Asked Questions (FAQs) — Call Girls in <%= city.name %></h3>
    
    <div style="background: #faf7f8; border-radius: 12px; padding: 20px; margin-top: 16px; border: 1px solid #f0e6e9;">
      <h4 style="margin: 0 0 8px 0; color: #800e28; font-size: 1.1rem;">Q1: How do I book a verified call girl in <%= city.name %>?</h4>
      <p style="margin: 0 0 16px 0;">Browse the verified profile cards above, choose your favorite companion, and click the direct <strong>WhatsApp button</strong> or Call <a href="tel:<%= typeof pagePhone !== 'undefined' ? pagePhone : '6351615378' %>" style="color: #b31b3b; font-weight: 700;">+91 <%= typeof displayPhone !== 'undefined' ? displayPhone : '6351615378' %></a> to discuss details directly.</p>
      
      <h4 style="margin: 0 0 8px 0; color: #800e28; font-size: 1.1rem;">Q2: Are the profile photos of <%= city.name %> escorts real?</h4>
      <p style="margin: 0 0 16px 0;">Yes. All profiles published on Sanjana Malhotra undergo identity and photo verification to ensure what you see is genuine.</p>

      <h4 style="margin: 0 0 8px 0; color: #800e28; font-size: 1.1rem;">Q3: What areas in <%= city.name %> are covered?</h4>
      <p style="margin: 0;">Our independent companions are available across all prime locations, luxury 5-star hotels, and residential areas in <%= city.name %> and nearby localities.</p>
    </div>
  </div>
</section>
<% } %>

<% if (relatedCategories.length || relatedCities.length) { %>
<section class="section section--light">
  <div class="container">
    <div class="section-heading">
      <div>
        <span class="eyebrow eyebrow--dark">Keep exploring</span>
        <h2>Explore Other Top Locations & Categories</h2>
      </div>
    </div>
    <div class="pill-grid">
      <% relatedCategories.forEach(item => { %>
        <a class="city-pill" href="<%= city ? `/${city.slug}/${item.slug}` : `/category/${item.slug}` %>">
          <strong><%= item.name %> in <%= city ? city.name : 'India' %></strong>
          <span>Explore →</span>
        </a>
      <% }) %>
      <% relatedCities.forEach(item => { %>
        <a class="city-pill" href="<%= category ? `/${item.slug}/${category.slug}` : `/${item.slug}` %>">
          <strong>Call Girls in <%= item.name %></strong>
          <span>Explore →</span>
        </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>
