<% layout('layouts/public') %>
<section class="profile-page">
  <div class="container">
    <nav class="breadcrumbs breadcrumbs--dark" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/<%= profile.city.slug %>"><%= profile.city.name %></a><span>›</span><a href="/<%= profile.city.slug %>/<%= profile.category.slug %>"><%= profile.category.name %></a><span>›</span><span><%= profile.name %></span></nav>
    <div class="profile-layout">
      <div class="gallery" data-gallery>
        <div class="gallery__main">
          <% if (profile.mainImage) { %>
          <button type="button" class="gallery-open" data-gallery-open aria-label="Open full-screen gallery"><img src="<%= profile.mainImage.url %>" alt="<%= profile.mainImage.alt || profile.name %>" width="900" height="1125" data-main-image></button>
          <% } else { %><div class="image-placeholder"><span><%= profile.name.charAt(0) %></span></div><% } %>
          <% if (profile.badge !== 'NORMAL') { %><span class="badge badge--<%= profile.badge.toLowerCase() %>"><%= profile.badge %></span><% } %>
          <% if (profile.images.length > 1) { %><button type="button" class="gallery-nav gallery-nav--prev" data-gallery-prev aria-label="Previous photo">‹</button><button type="button" class="gallery-nav gallery-nav--next" data-gallery-next aria-label="Next photo">›</button><span class="gallery-count"><b data-gallery-current>1</b> / <%= profile.images.length %></span><% } %>
        </div>
        <% if (profile.images.length > 1) { %>
        <div class="gallery__thumbs" aria-label="Profile photos">
          <% profile.images.forEach((item, index) => { %><button type="button" class="gallery-thumb <%= index === 0 ? 'active' : '' %>" data-gallery-index="<%= index %>" data-gallery-src="<%= item.url %>" data-gallery-alt="<%= item.alt || `${profile.name} photo ${index + 1}` %>"><img src="<%= item.url %>" alt="<%= profile.name %> photo <%= index + 1 %>" loading="lazy"></button><% }) %>
        </div>
        <p class="gallery-help">Select a thumbnail or use the arrows · Click the main photo for fullscreen</p>
        <% } %>
      </div>

      <article class="profile-info">
        <p class="profile-info__location"><a href="/<%= profile.city.slug %>"><%= profile.city.name %></a><span>•</span><a href="/category/<%= profile.category.slug %>"><%= profile.category.name %></a></p>
        <h1><%= profile.name %></h1>
        <div class="profile-flags"><span>18+ age verified</span><span>Consent verified</span><% if (profile.featured) { %><span>Featured</span><% } %></div>
        <% if (profile.displayAge || profile.heightCm || profile.area || profile.availability || profile.languages?.length) { %>
        <section class="detail-panel"><h2>Profile details</h2><dl>
          <% if (profile.displayAge) { %><div><dt>Age</dt><dd><%= profile.displayAge %> years</dd></div><% } %>
          <% if (profile.heightCm) { %><div><dt>Height</dt><dd><%= profile.heightCm %> cm</dd></div><% } %>
          <% if (profile.area) { %><div><dt>Area</dt><dd><%= profile.area %></dd></div><% } %>
          <% if (profile.availability) { %><div><dt>Availability</dt><dd><%= profile.availability %></dd></div><% } %>
          <% if (profile.languages?.length) { %><div><dt>Languages</dt><dd><%= profile.languages.join(', ') %></dd></div><% } %>
          <div><dt>Category</dt><dd><%= profile.category.name %></dd></div>
        </dl></section>
        <% } %>
        <section class="about-profile"><h2>About <%= profile.name %></h2><p class="profile-description"><%= profile.description %></p></section>
        <% if (profile.tags.length) { %><div class="tag-list"><% profile.tags.forEach(tag => { %><span><%= tag %></span><% }) %></div><% } %>
        <div class="connect-box" id="connect">
          <small>Direct & Independent Contact</small>
          <h2>Connect with <%= profile.name %></h2>
          <p>Connect directly via verified WhatsApp. Sanjana Malhotra does not arrange meetings or take commissions.</p>
          <% if (profile.whatsappUrl) { %>
            <a class="button button--whatsapp button--wide" href="<%= profile.whatsappUrl %>" target="_blank" rel="noopener noreferrer">
              <svg class="whatsapp-icon" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.978-.276-.1-.477-.15-.677.15-.2.301-.777.978-.953 1.18-.175.201-.351.226-.652.075-.301-.15-1.272-.469-2.423-1.496-.895-.799-1.5-1.786-1.676-2.087-.175-.301-.019-.464.132-.614.136-.135.301-.351.452-.527.15-.175.2-.301.301-.501.1-.201.05-.376-.025-.527-.075-.15-.677-1.633-.928-2.238-.244-.59-.492-.51-.677-.52l-.577-.01c-.2 0-.527.075-.803.376s-1.053 1.028-1.053 2.508 1.079 2.909 1.229 3.11c.15.201 2.124 3.243 5.145 4.549.719.31 1.28.496 1.718.636.722.23 1.378.197 1.898.12.579-.087 1.78-.728 2.03-1.43.25-.703.25-1.305.175-1.43-.075-.125-.276-.201-.577-.351z"/>
                <path d="M12 2C6.477 2 2 6.477 2 12c0 1.892.524 3.662 1.435 5.178L2 22l4.98-1.39A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.05c-1.626 0-3.14-.478-4.417-1.302l-.317-.204-2.964.827.842-2.887-.225-.339A8.006 8.006 0 0 1 4 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8.05-8 8.05z"/>
              </svg>
              <span>Chat on WhatsApp <% if (profile.whatsapp) { %>(+<%= profile.whatsapp %>)<% } %></span>
            </a>
          <% } %>
          <% if (profile.phone) { %>
            <a class="button button--ghost button--wide" href="tel:<%= profile.phone %>">
              <span>Call <%= profile.name %> (<%= profile.phone %>)</span>
            </a>
          <% } %>
        </div>
        <button class="report-link" type="button" data-report-open>Report this profile</button>
      </article>
    </div>
  </div>
</section>

<% if (related.length) { %><section class="section section--cream related-profiles"><div class="container"><div class="section-heading"><div><span class="eyebrow eyebrow--dark">Continue exploring</span><h2>More profiles you may like</h2></div><a class="text-link" href="/search">View all profiles →</a></div><div class="card-grid"><% related.forEach(item => { %><%- include('../partials/profile-card', { profile: item }) %><% }) %></div></div></section><% } %>

<% if (profile.images.length) { %><dialog class="lightbox" data-lightbox><button type="button" class="lightbox-close" data-lightbox-close aria-label="Close fullscreen gallery">×</button><button type="button" class="lightbox-nav lightbox-nav--prev" data-gallery-prev aria-label="Previous photo">‹</button><img src="<%= profile.mainImage.url %>" alt="<%= profile.mainImage.alt || profile.name %>" data-lightbox-image><button type="button" class="lightbox-nav lightbox-nav--next" data-gallery-next aria-label="Next photo">›</button><span class="lightbox-count"><b data-lightbox-current>1</b> / <%= profile.images.length %></span></dialog><% } %>

<dialog class="report-dialog" data-report-dialog><button class="dialog-close" data-report-close aria-label="Close">×</button><span class="eyebrow eyebrow--dark">Safety report</span><h2>Report <%= profile.name %></h2><p>Reports are confidential and reviewed by our moderation team.</p><form method="post" action="/report"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="profileId" value="<%= profile._id %>"><label>Reason<select name="reason" required><option value="">Choose a reason</option><option value="underage">Potentially underage</option><option value="non-consensual">Non-consensual content</option><option value="fraud">Fraud or impersonation</option><option value="privacy">Privacy concern</option><option value="illegal">Illegal or exploitative activity</option><option value="spam">Spam</option><option value="other">Other</option></select></label><label>Details<textarea name="details" maxlength="2000" rows="5"></textarea></label><label>Your email (optional)<input type="email" name="email" maxlength="180"></label><button class="button button--gold" type="submit">Submit confidential report</button></form></dialog>

