<% layout('layouts/public') %>
<section class="page-hero page-hero--compact"><div class="container narrow"><span class="eyebrow">Safety first</span><h1>Report prohibited content</h1><p>Your report is confidential and goes directly to the moderation queue. Include only the detail needed to investigate.</p></div></section><section class="section section--light"><div class="container narrow"><form class="public-form" method="post" action="/report"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Reason<select name="reason" required><option value="">Choose a reason</option><option value="underage">Potentially underage</option><option value="non-consensual">Non-consensual content</option><option value="fraud">Fraud or impersonation</option><option value="privacy">Privacy concern</option><option value="illegal">Illegal or exploitative activity</option><option value="spam">Spam</option><option value="other">Other</option></select></label><label>Details<textarea name="details" maxlength="2000" rows="7" placeholder="Add the profile URL and enough detail for review."></textarea></label><label>Your email (optional)<input type="email" name="email" maxlength="180" autocomplete="email"></label><button class="button button--gold" type="submit">Submit confidential report</button></form></div></section>
