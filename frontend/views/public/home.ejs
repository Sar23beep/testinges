<% layout('layouts/public') %>
<section class="hero hero--lux">
  <div class="container hero__inner">
    <div class="hero__layout">
      <!-- Left Column: Copy, Category Tabs, Search & Stats -->
      <div class="hero__content">
        <div class="hero__status-badge">
          <span class="status-dot"></span>
          <span>1,770+ Verified Profiles Online Across India</span>
          <span class="badge-separator">•</span>
          <span class="badge-highlight">100% Direct Contact</span>
        </div>
        
        <h1 class="hero__title">
          India’s Premier <em>Luxury & Independent</em> Escort Directory
        </h1>
        
        <p class="hero__subtitle">
          Connect directly with verified independent companions, VIP models, and elite escorts across 180+ cities in India. 100% verified photos, direct WhatsApp chats, and strict privacy.
        </p>

        <!-- Category Pill Tabs -->
        <div class="hero__category-tabs">
          <button type="button" class="cat-tab active" data-cat-id="">✨ All Profiles</button>
          <% categories.slice(0, 6).forEach(cat => { %>
            <button type="button" class="cat-tab" data-cat-id="<%= cat._id %>"><%= cat.name %></button>
          <% }) %>
        </div>

        <!-- Glassmorphic Search Bar -->
        <form class="hero-search-box" action="/search" method="get" id="heroSearchForm">
          <div class="search-field">
            <span class="search-field__icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <div class="search-field__inputs">
              <label for="hero-city-select">Choose City / Location</label>
              <select id="hero-city-select" name="city">
                <option value="">All Indian Cities (180+ Available)</option>
                <% cities.forEach(city => { %>
                  <option value="<%= city._id %>"><%= city.name %> (<%= city.state %>)</option>
                <% }) %>
              </select>
            </div>
          </div>

          <div class="search-field">
            <span class="search-field__icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </span>
            <div class="search-field__inputs">
              <label for="hero-category-select">Profile Category</label>
              <select id="hero-category-select" name="category">
                <option value="">All Categories</option>
                <% categories.forEach(category => { %>
                  <option value="<%= category._id %>"><%= category.name %></option>
                <% }) %>
              </select>
            </div>
          </div>

          <button class="hero-search-btn" type="submit">
            <span>Explore Profiles</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </form>

        <!-- Top Cities Quick Access -->
        <div class="hero__quick-cities">
          <span class="quick-cities__label">🔥 Trending Cities:</span>
          <div class="quick-cities__list">
            <% cities.slice(0, 9).forEach(c => { %>
              <a href="/<%= c.slug %>" class="quick-city-chip"><%= c.name %></a>
            <% }) %>
          </div>
        </div>

        <!-- Live Statistics Counter Grid -->
        <div class="hero__stats-row">
          <div class="stat-item">
            <strong>180+</strong>
            <span>Active Cities</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <strong>1,770+</strong>
            <span>Verified Profiles</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <strong>100%</strong>
            <span>Direct WhatsApp</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <strong>0%</strong>
            <span>Middlemen / Agents</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Live Spotlight Showcase Card with Floating Glass Overlays -->
      <% const heroFeatured = featured && featured.length ? featured[0] : null; %>
      <% if (heroFeatured) { %>
      <div class="hero__showcase">
        <div class="showcase-card-wrapper">
          <!-- Floating Badge Top Left: Customer Rating & Avatars -->
          <div class="floating-proof-card proof-card--top">
            <div class="proof-avatars">
              <span class="proof-dot">⭐</span>
              <span class="proof-dot">⭐</span>
              <span class="proof-dot">⭐</span>
            </div>
            <div class="proof-text">
              <strong>4.9 / 5 Verified</strong>
              <small>Discreet Hospitality</small>
            </div>
          </div>

          <!-- Main Spotlight Showcase Card -->
          <div class="showcase-card">
            <div class="showcase-card__image-wrap">
              <img src="<%= heroFeatured.mainImage ? heroFeatured.mainImage.url : '/images/profiles/profile-photo-1.jpeg' %>" alt="<%= heroFeatured.name %>" class="showcase-card__img" loading="eager" />
              <div class="showcase-card__overlay"></div>
              
              <div class="showcase-card__top-tags">
                <span class="badge badge--vvip">👑 VVIP SPOTLIGHT</span>
                <span class="showcase-online-tag"><span class="status-dot"></span> Active Now</span>
              </div>

              <div class="showcase-card__bottom-info">
                <div class="showcase-card__details">
                  <span class="showcase-location">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    <%= heroFeatured.city ? heroFeatured.city.name : 'Mumbai' %> <%= heroFeatured.area ? '• ' + heroFeatured.area : '' %>
                  </span>
                  <h3><%= heroFeatured.name %> <span class="showcase-age">(<%= heroFeatured.displayAge || 24 %> yrs)</span></h3>
                  <div class="showcase-pills">
                    <span class="showcase-pill"><%= heroFeatured.category ? heroFeatured.category.name : 'Elite Companion' %></span>
                    <span class="showcase-pill">100% Genuine</span>
                  </div>
                </div>

                <div class="showcase-card__actions">
                  <a class="button button--whatsapp button--small" href="<%= heroFeatured.whatsappUrl || `/profile/${heroFeatured.slug}` %>" target="_blank" rel="noopener noreferrer">
                    <svg class="whatsapp-icon" viewBox="0 0 24 24" width="17" height="17" fill="currentColor">
                      <path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.978-.276-.1-.477-.15-.677.15-.2.301-.777.978-.953 1.18-.175.201-.351.226-.652.075-.301-.15-1.272-.469-2.423-1.496-.895-.799-1.5-1.786-1.676-2.087-.175-.301-.019-.464.132-.614.136-.135.301-.351.452-.527.15-.175.2-.301.301-.501.1-.201.05-.376-.025-.527-.075-.15-.677-1.633-.928-2.238-.244-.59-.492-.51-.677-.52l-.577-.01c-.2 0-.527.075-.803.376s-1.053 1.028-1.053 2.508 1.079 2.909 1.229 3.11c.15.201 2.124 3.243 5.145 4.549.719.31 1.28.496 1.718.636.722.23 1.378.197 1.898.12.579-.087 1.78-.728 2.03-1.43.25-.703.25-1.305.175-1.43-.075-.125-.276-.201-.577-.351z"/>
                      <path d="M12 2C6.477 2 2 6.477 2 12c0 1.892.524 3.662 1.435 5.178L2 22l4.98-1.39A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.05c-1.626 0-3.14-.478-4.417-1.302l-.317-.204-2.964.827.842-2.887-.225-.339A8.006 8.006 0 0 1 4 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8.05-8 8.05z"/>
                    </svg>
                    <span>Chat Direct</span>
                  </a>
                  <a href="/profile/<%= heroFeatured.slug %>" class="showcase-view-link">View Details →</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Floating Badge Bottom Right: Instant Reply -->
          <div class="floating-proof-card proof-card--bottom">
            <div class="proof-icon-pulse">
              <span class="status-dot"></span>
            </div>
            <div class="proof-text">
              <strong>Direct WhatsApp Chat</strong>
              <small>Zero Middlemen</small>
            </div>
          </div>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.cat-tab');
    const catSelect = document.getElementById('hero-category-select');
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const catId = tab.getAttribute('data-cat-id');
        if (catSelect) {
          catSelect.value = catId;
        }
      });
    });
  });
</script>

<section class="section section--light"><div class="container"><div class="section-heading"><div><span class="eyebrow eyebrow--dark">Find your place</span><h2>Explore by city</h2></div><a class="text-link" href="/search">View all profiles →</a></div><div class="pill-grid"><% cities.forEach(city => { %><a class="city-pill" href="/<%= city.slug %>"><strong><%= city.name %></strong><span>Explore →</span></a><% }) %></div></div></section>

<% const sections = [{ title: 'Featured selection', subtitle: 'Editor’s selection', items: featured }, { title: 'VVIP profiles', subtitle: 'The signature collection', items: vvip }, { title: 'VIP profiles', subtitle: 'Premium discovery', items: vip }, { title: 'Trending now', subtitle: 'Hot profiles', items: hot }, { title: 'Recently added', subtitle: 'Fresh arrivals', items: recent }]; %>
<% sections.forEach((section, index) => { if (section.items.length) { %>
<section class="section <%= index % 2 ? 'section--ink' : 'section--cream' %>"><div class="container"><div class="section-heading"><div><span class="eyebrow <%= index % 2 ? '' : 'eyebrow--dark' %>"><%= section.subtitle %></span><h2><%= section.title %></h2></div><a class="text-link" href="/search">Explore all →</a></div><div class="card-grid"><% section.items.forEach(profile => { %><%- include('../partials/profile-card', { profile }) %><% }) %></div></div></section>
<% } }) %>

<section class="section section--light"><div class="container split-section"><div><span class="eyebrow eyebrow--dark">Browse your way</span><h2>Curated categories</h2><p>Find profiles that align with what you’re looking for. Every category is managed and reviewed by our moderation team.</p></div><div class="category-list"><% categories.forEach(category => { %><a href="/category/<%= category.slug %>"><span><%= category.name %></span><small><%= category.description ? category.description.slice(0, 60) : 'Explore profiles' %></small><b>→</b></a><% }) %></div></div></section>

<section class="trust-section"><div class="container"><div class="trust-copy"><span class="eyebrow">Pleasure with standards</span><h2>Adults. Consent. Privacy. Always.</h2><p>Veloura is a moderated 18+ discovery directory. We verify publication consent, protect personal data and never process bookings or payments.</p><a class="button button--outline" href="/about">Our safety standard</a></div><div class="trust-grid"><article><span>01</span><h3>18+ verified</h3><p>Age and publication consent are mandatory before any profile goes live.</p></article><article><span>02</span><h3>Private by design</h3><p>Only approved discovery information is shown publicly.</p></article><article><span>03</span><h3>Human moderation</h3><p>Clear reporting and instant unpublishing support rapid review.</p></article><article><span>04</span><h3>Direct conversation</h3><p>Connect independently on WhatsApp. No middlemen or booking fees.</p></article></div></div></section>
